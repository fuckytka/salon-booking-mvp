alue="1 : 0..N | customer_id" style="exitX=1;exitY=0.35;entryX=0;entryY=0.35;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#17695f;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user_account" target="bookings"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="1 : 0..N | timeslot_id" style="exitX=0;exitY=0.35;entryX=1;entryY=0.35;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#17695f;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="timeslots" target="bookings"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="1 : 0..N | service_id" style="exitX=0.5;exitY=0;entryX=0.827586;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#17695f;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="bookings"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="740" y="280" /><mxPoint x="680" y="280" /></Array></mxGeometry></mxCell><mxCell id="e3" value="1 : 0..N | recipient_id" style="exitX=0.392857;exitY=1;entryX=0.297297;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;strokeColor=#17695f;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user_account" target="notifications_outbox"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="1 : 1 | booking_id" style="exitX=0.137931;exitY=1;entryX=0.891892;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERmandOne;strokeColor=#17695f;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bookings" target="notifications_outbox"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="480" y="280" /><mxPoint x="370" y="280" /></Array></mxGeometry></mxCell><mxCell id="notes" value="capacity = 3; активні лише confirmed. Слот спільний: service_id міститься у bookings.&lt;br/&gt;U1 = UNIQUE(booking_id, event_type); event_type = booking_confirmed.&lt;br/&gt;Після commit кожне бронювання має одну подію. cancelled_at: NULL лише для confirmed.&lt;br/&gt;Доступність і кількість вільних місць обчислюються; is_available не зберігається." style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="520" width="660" height="100" /></mxCell></root></mxGraphModel></diagram><diagram id="logical" name="Логічна ERD"><mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="user_account" value="&lt;b&gt;user_account&lt;/b&gt;&lt;hr/&gt;PK user_id : uuid [NN]&lt;br/&gt; full_name : varchar(120) [NN]&lt;br/&gt;UQ email : varchar(254) [NN]&lt;br/&gt; phone : varchar(20) [NULL]&lt;br/&gt; password_hash : text [NN]&lt;br/&gt; role : enum [E2] [NN]&lt;br/&gt; is_active : boolean [NN]&lt;br/&gt; created_at : timestamptz [NN]&lt;br/&gt; updated_at : timestamptz [NN]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf4f2;strokeColor=#17695f;fontFamily=Arial;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="110" width="280" height="247" /></mxCell><mxCell id="bookings" value="&lt;b&gt;bookings&lt;/b&gt;&lt;hr/&gt;PK booking_id : uuid [NN]&lt;br/&gt;UQ request_id : uuid [NN]&lt;br/&gt;FK customer_id : uuid [NN]&lt;br/&gt;FK service_id : uuid [NN]&lt;br/&gt;FK timeslot_id : uuid [NN]&lt;br/&gt; status : enum [E1] [NN]&lt;br/&gt; created_at : timestamptz [NN]&lt;br/&gt; updated_at : timestamptz [NN]&lt;br/&gt; cancelled_at : timestamptz [NULL]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf4f2;strokeColor=#17695f;fontFamily=Arial;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="110" width="290" height="247" /></mxCell><mxCell id="timeslots" value="&lt;b&gt;timeslots&lt;/b&gt;&lt;hr/&gt;PK timeslot_id : uuid [NN]&lt;br/&gt; start_at : timestamptz [NN]&lt;br/&gt; end_at : timestamptz [NN]&lt;br/&gt; capacity : smallint [NN]&lt;br/&gt; is_blocked : boolean [NN]&lt;br/&gt; created_at : timestamptz [NN]&lt;br/&gt; updated_at : timestamptz [NN]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf4f2;strokeColor=#17695f;fontFamily=Arial;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="110" width="270" height="201" /></mxCell><mxCell id="notifications_outbox" value="&lt;b&gt;notifications_outbox&lt;/b&gt;&lt;hr/&gt;PK event_id : uuid [NN]&lt;br/&gt; U1 event_type : enum [E3] [NN]&lt;br/&gt; request_id : uuid [NN]&lt;br/&gt;FK U1 booking_id : uuid [NN]&lt;br/&gt;FK recipient_id : uuid [NN]&lt;br/&gt; payload : jsonb [NN]&lt;br/&gt; created_at : timestamptz [NN]&lt;br/&gt; status : enum [E4] [NN]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf4f2;strokeColor=#17695f;fontFamily=Arial;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="490" width="370" height="224" /></mxCell><mxCell id="services" value="&lt;b&gt;services&lt;/b&gt;&lt;hr/&gt;PK service_id : uuid [NN]&lt;br/&gt; title : varchar(160) [NN]&lt;br/&gt; duration : integer [NN]&lt;br/&gt; price : numeric(10,2) [NN]&lt;br/&gt; is_active : boolean [NN]&lt;br/&gt; created_at : timestamptz [NN]&lt;br/&gt; updated_at : timestamptz [NN]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ecf4f2;strokeColor=#17695f;fontFamily=Arial;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="490" width="300" height="201" /></mxCell><mxCell id="e0" value="1 : 0..N | customer_id" style="exitX=1;exitY=0.35;entryX=0;